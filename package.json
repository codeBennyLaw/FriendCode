{
  "name": "friendcode",
  "version": "2.0.0",
  "private": true,
  "description": "A small Node.js friend-code community with owner-only account recovery.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.js",
    "migrate": "node scripts/manage.js migrate",
    "backup": "node scripts/manage.js backup",
    "owner:reset": "node scripts/manage.js owner-reset",
    "test:e2e": "playwright test",
    "restore": "node scripts/restore.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "files": [
    "public/",
    "src/",
    "scripts/",
    "server.js",
    ".env.example",
    "deploy/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "license": "MIT"
}
