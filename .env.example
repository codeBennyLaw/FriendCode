# Optional. On a fresh interactive start, the setup wizard writes OWNER_QQ here.
OWNER_QQ=
# Initial invitation code only. Empty generates one on first setup. Later changes use the admin panel.
REGISTER_CODE=
HOST=127.0.0.1
PORT=3000
# Optional private data directory; defaults to this project directory.
DATA_DIR=.
# Example: /friendcode. Leave empty to serve at the domain root.
BASE_PATH=
# Example: https://friends.example.com (no trailing slash or path).
PUBLIC_ORIGIN=
# Use true with HTTPS in production; false only for local HTTP development.
COOKIE_SECURE=false
# Enable only behind a trusted proxy which overwrites X-Forwarded-For.
TRUST_PROXY=false
